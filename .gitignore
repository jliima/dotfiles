.directory
.stfolder
.stignore
*.kate-swp
__pycache__
.env/
.config/Code/*
!.config/Code/User/settings.json
!.config/Code/User/keybindings.json

scripts/*
!scripts/claude-desktop
!scripts/kde
!scripts/applications

.mozilla/*
