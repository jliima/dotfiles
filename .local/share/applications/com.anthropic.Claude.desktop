[Desktop Entry]
Name=Claude
Comment=Desktop application for Claude.ai
GenericName=AI Assistant
Keywords=AI;Chat;Assistant;Claude;Code;LLM;
Exec=claude-desktop --disable-features=WaylandWpColorManagerV1 %U
Icon=claude-desktop
Type=Application
StartupNotify=true
# Matches the Wayland app_id / X11 WM_CLASS Chromium derives from
# package.json desktopName, so docks group windows under this entry.
StartupWMClass=com.anthropic.Claude
# second-instance just focuses mainWindow; suppress GNOME's default "New Window" item
SingleMainWindow=true
Categories=Utility;Development;
MimeType=x-scheme-handler/claude;application/vnd.anthropic.mcpb;application/vnd.anthropic.skill;
TryExec=claude-desktop
Actions=NewChat;NewCode;ContinueLast;NeedsInput;
X-Claude-Generated=true

[Desktop Action NewChat]
Name=New Chat
Exec=claude-desktop --disable-features=WaylandWpColorManagerV1 "claude://claude.ai/new?surface=chat&source=desktop_action"

[Desktop Action NewCode]
Name=New Claude Code Session
Exec=claude-desktop --disable-features=WaylandWpColorManagerV1 "claude://code/new?source=desktop_action"

[Desktop Action ContinueLast]
Name=Continue Last Claude Code Session
Exec=claude-desktop --disable-features=WaylandWpColorManagerV1 "claude://code/continue?session=last&source=desktop_action"

[Desktop Action NeedsInput]
Name=Sessions Waiting for You
Exec=claude-desktop --disable-features=WaylandWpColorManagerV1 "claude://code/needs-input?source=desktop_action"
