  ],
  "semanticTokenColors": {
    "class": "#82c5ff",
    "interface": "#2bc5c7",
    "enum": "#2bc5c7",
    "enumMember": "#f45959",
    "struct": "#82c5ff",
    "type": "#2bc5c7",
    "typeParameter": "#2bc5c7",
    "namespace": "#2bc5c7",
    "function": "#5faff1",
    "method": "#5faff1",
    "macro": "#ad8ded",
    "decorator": "#ad8ded",
    "property": "#2bc5c7",
    "variable": "#d1deeb",
    "parameter": "#d1deeb",
    "variable.readonly": "#f45959",
    "variable.defaultLibrary": "#2bc5c7",
    "function.defaultLibrary": "#5faff1",
    "*.deprecated": {"foreground": "#f58d31", "strikethrough": true}
  }
