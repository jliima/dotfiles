// Custom Finnish-US hybrid keyboard layout
//
// US-style number row and punctuation with Finnish ö/ä in their
// traditional positions. Based on SFS 5966 / Kotoistus layout.

default partial alphanumeric_keys
xkb_symbols "basic" {

    name[Group1]="Finnish (Custom US hybrid)";

//		    Plain            Shift             Right Alt
// ----------------------------------------------------------------------------------------------------
    // Number row: US-style shift symbols, Finnish AltGr layer
    key <TLDE> { [  grave,           asciitilde,       apostrophe,            dead_stroke           ] };
    key <AE01> { [  1,               exclam,           NoSymbol,              exclamdown            ] };
    key <AE02> { [  2,               quotedbl,         at,                    rightdoublequotemark  ] };
    key <AE03> { [  3,               numbersign,       sterling,              guillemotright        ] };
    key <AE04> { [  4,               dollar,           currency,              guillemotleft         ] };
    key <AE05> { [  5,               percent,          permille,              leftdoublequotemark   ] };
    key <AE06> { [  6,               asciicircum,      singlelowquotemark,    doublelowquotemark    ] };
    key <AE07> { [  7,               ampersand,        braceleft,             NoSymbol              ] };
    key <AE08> { [  8,               asterisk,         bracketleft,           less                  ] };
    key <AE09> { [  9,               parenleft,        bracketright,          greater               ] };
    key <AE10> { [  0,               parenright,       braceright,            degree                ] };
    key <AE11> { [  minus,           underscore,       dead_stroke,           questiondown          ] };
    key <AE12> { [  equal,           plus,             dead_cedilla,          dead_ogonek           ] };

    // Top letter row: US bracket positions
    key <AD01> { [  q,               Q,                q,                     Q                     ] };
    key <AD02> { [  w,               W,                w,                     W                     ] };
    key <AD03> { [  e,               E,                EuroSign,              NoSymbol              ] };
    key <AD04> { [  r,               R,                r,                     R                     ] };
    key <AD05> { [  t,               T,                thorn,                 THORN                 ] };
    key <AD06> { [  y,               Y,                y,                     Y                     ] };
    key <AD07> { [  u,               U,                u,                     U                     ] };
    key <AD08> { [  i,               I,                idotless,              bar                   ] };
    key <AD09> { [  o,               O,                oe,                    OE                    ] };
    key <AD10> { [  p,               P,                dead_horn,             dead_hook             ] };
    key <AD11> { [  bracketleft,     braceleft,        dead_doubleacute,      dead_abovering        ] };
    key <AD12> { [  bracketright,    braceright,       dead_tilde,            dead_macron           ] };

    // Home row: Finnish ö/ä in their traditional positions
    key <AC01> { [  a,               A,                schwa,                 SCHWA                 ] };
    key <AC02> { [  s,               S,                ssharp,                NoSymbol              ] };
    key <AC03> { [  d,               D,                eth,                   ETH                   ] };
    key <AC04> { [  f,               F,                f,                     F                     ] };
    key <AC05> { [  g,               G,                g,                     G                     ] };
    key <AC06> { [  h,               H,                h,                     H                     ] };
    key <AC07> { [  j,               J,                j,                     J                     ] };
    key <AC08> { [  k,               K,                kra,                   NoSymbol              ] };
    key <AC09> { [  l,               L,                dead_stroke,           NoSymbol              ] };
    key <AC10> { [  odiaeresis,      Odiaeresis,       oslash,                Oslash                ] };
    key <AC11> { [  adiaeresis,      Adiaeresis,       ae,                    AE                    ] };
    key <BKSL> { [  backslash,       bar,              dead_caron,            dead_breve            ] };

    // Bottom row
    key <LSGT> { [  less,            greater,          bar,                   NoSymbol              ] };
    key <AB01> { [  z,               Z,                ezh,                   EZH                   ] };
    key <AB02> { [  x,               X,                multiply,              periodcentered        ] };
    key <AB03> { [  c,               C,                c,                     C                     ] };
    key <AB04> { [  v,               V,                v,                     V                     ] };
    key <AB05> { [  b,               B,                b,                     B                     ] };
    key <AB06> { [  n,               N,                eng,                   ENG                   ] };
    key <AB07> { [  m,               M,                mu,                    emdash                ] };
    key <AB08> { [  comma,           semicolon,        less,                  less                  ] };
    key <AB09> { [  period,          colon,            greater,               greater               ] };
    key <AB10> { [  slash,           question,         endash,                dead_belowcomma       ] };

    include "nbsp(level4)"
    include "nbsp(level3)"
    include "kpdl(comma)"
    include "level3(ralt_switch)"
};
