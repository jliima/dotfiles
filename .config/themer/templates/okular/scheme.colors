# Okular's own copy of the Plasma color scheme (templates/kde/scheme.colors) with the accent as selection. Okular
# paints text selections and search hits onto the page with a multiply blend, which can only darken: on a dark page the
# selection color of the normal scheme (a dark navy) turns selected text almost black. Keep it in step with the original.
[ColorEffects:Disabled]
Color={{ bg | rgb }}
ColorAmount=0.55
ColorEffect=3
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=false
Color={{ bg | rgb }}
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{ surface-active | rgb }}
BackgroundNormal={{ surface-hover | rgb }}
DecorationFocus={{ focus-ring | rgb }}
DecorationHover={{ accent | rgb }}
ForegroundActive={{ accent | rgb }}
ForegroundInactive={{ text-subtle | rgb }}
ForegroundLink={{ link | rgb }}
ForegroundNegative={{ danger | rgb }}
ForegroundNeutral={{ warning | rgb }}
ForegroundNormal={{ text | rgb }}
ForegroundPositive={{ success | rgb }}
ForegroundVisited={{ violet | rgb }}

[Colors:Complementary]
BackgroundAlternate={{ surface | rgb }}
BackgroundNormal={{ bg-deep | rgb }}
DecorationFocus={{ focus-ring | rgb }}
DecorationHover={{ accent | rgb }}
ForegroundActive={{ accent | rgb }}
ForegroundInactive={{ text-subtle | rgb }}
ForegroundLink={{ link | rgb }}
ForegroundNegative={{ danger | rgb }}
ForegroundNeutral={{ warning | rgb }}
ForegroundNormal={{ text | rgb }}
ForegroundPositive={{ success | rgb }}
ForegroundVisited={{ violet | rgb }}

[Colors:Header]
BackgroundAlternate={{ bg-sunken | rgb }}
BackgroundNormal={{ bg-deep | rgb }}
DecorationFocus={{ focus-ring | rgb }}
DecorationHover={{ accent | rgb }}
ForegroundActive={{ accent | rgb }}
ForegroundInactive={{ text-subtle | rgb }}
ForegroundLink={{ link | rgb }}
ForegroundNegative={{ danger | rgb }}
ForegroundNeutral={{ warning | rgb }}
ForegroundNormal={{ text | rgb }}
ForegroundPositive={{ success | rgb }}
ForegroundVisited={{ violet | rgb }}

[Colors:Header][Inactive]
BackgroundAlternate={{ bg-sunken | rgb }}
BackgroundNormal={{ bg-deep | rgb }}
DecorationFocus={{ focus-ring | rgb }}
DecorationHover={{ accent | rgb }}
ForegroundActive={{ accent | rgb }}
ForegroundInactive={{ text-faint | rgb }}
ForegroundLink={{ link | rgb }}
ForegroundNegative={{ danger | rgb }}
ForegroundNeutral={{ warning | rgb }}
ForegroundNormal={{ text-subtle | rgb }}
ForegroundPositive={{ success | rgb }}
ForegroundVisited={{ violet | rgb }}

[Colors:Selection]
BackgroundAlternate={{ accent | rgb }}
BackgroundNormal={{ accent | rgb }}
DecorationFocus={{ focus-ring | rgb }}
DecorationHover={{ accent | rgb }}
ForegroundActive={{ on-accent | rgb }}
ForegroundInactive={{ on-accent | rgb }}
ForegroundLink={{ on-accent | rgb }}
ForegroundNegative={{ danger | rgb }}
ForegroundNeutral={{ warning | rgb }}
ForegroundNormal={{ on-accent | rgb }}
ForegroundPositive={{ success | rgb }}
ForegroundVisited={{ on-accent | rgb }}

[Colors:Tooltip]
BackgroundAlternate={{ surface | rgb }}
BackgroundNormal={{ surface-raised | rgb }}
DecorationFocus={{ focus-ring | rgb }}
DecorationHover={{ accent | rgb }}
ForegroundActive={{ accent | rgb }}
ForegroundInactive={{ text-subtle | rgb }}
ForegroundLink={{ link | rgb }}
ForegroundNegative={{ danger | rgb }}
ForegroundNeutral={{ warning | rgb }}
ForegroundNormal={{ text | rgb }}
ForegroundPositive={{ success | rgb }}
ForegroundVisited={{ violet | rgb }}

[Colors:View]
BackgroundAlternate={{ bg | mix(surface, 0.35) | rgb }}
BackgroundNormal={{ bg | rgb }}
DecorationFocus={{ focus-ring | rgb }}
DecorationHover={{ accent | rgb }}
ForegroundActive={{ accent | rgb }}
ForegroundInactive={{ text-subtle | rgb }}
ForegroundLink={{ link | rgb }}
ForegroundNegative={{ danger | rgb }}
ForegroundNeutral={{ warning | rgb }}
ForegroundNormal={{ text | rgb }}
ForegroundPositive={{ success | rgb }}
ForegroundVisited={{ violet | rgb }}

[Colors:Window]
BackgroundAlternate={{ surface | rgb }}
BackgroundNormal={{ bg-sunken | rgb }}
DecorationFocus={{ focus-ring | rgb }}
DecorationHover={{ accent | rgb }}
ForegroundActive={{ accent | rgb }}
ForegroundInactive={{ text-subtle | rgb }}
ForegroundLink={{ link | rgb }}
ForegroundNegative={{ danger | rgb }}
ForegroundNeutral={{ warning | rgb }}
ForegroundNormal={{ text | rgb }}
ForegroundPositive={{ success | rgb }}
ForegroundVisited={{ violet | rgb }}

[General]
ColorScheme={{ scheme }}
Name={{ name }} {{ Variant }}
shadeSortColumn=false

[KDE]
contrast=4

[WM]
activeBackground={{ bg-deep | rgb }}
activeBlend={{ text | rgb }}
activeForeground={{ text-muted | rgb }}
inactiveBackground={{ bg-deep | rgb }}
inactiveBlend={{ text-faint | rgb }}
inactiveForeground={{ text-faint | rgb }}
