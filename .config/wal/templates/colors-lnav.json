{{
  "$schema": "https://lnav.org/schemas/config-v1.schema.json",
  "ui": {{
    "default-colors": true,
    "theme-defs": {{
      "pywal-colors": {{
        "vars": {{
          "bg": "{background}",
          "fg": "{foreground}",
          "black": "{black5}",
          "red": "{red5}",
          "green": "{green5}",
          "yellow": "{yellow5}",
          "blue": "{blue5}",
          "magenta": "{magenta5}",
          "cyan": "{cyan5}",
          "white": "{white5}",
          "black10": "{black1}",
          "black30": "{black2}",
          "black50": "{black3}",
          "black70": "{black4}",
          "black90": "{black5}",
          "white10": "{white1}",
          "white30": "{white2}",
          "white50": "{white3}",
          "white70": "{white4}",
          "white90": "{white5}",
          "grey10": "{grey1}",
          "grey30": "{grey2}",
          "grey50": "{grey3}",
          "grey70": "{grey4}",
          "grey90": "{grey5}",
          "red10": "{red1}",
          "red30": "{red2}",
          "red50": "{red3}",
          "red70": "{red4}",
          "red90": "{red5}",
          "green10": "{green1}",
          "green30": "{green2}",
          "green50": "{green3}",
          "green70": "{green4}",
          "green90": "{green5}",
          "blue10": "{blue1}",
          "blue30": "{blue2}",
          "blue50": "{blue3}",
          "blue70": "{blue4}",
          "blue90": "{blue5}",
          "yellow10": "{yellow1}",
          "yellow30": "{yellow2}",
          "yellow50": "{yellow3}",
          "yellow70": "{yellow4}",
          "yellow90": "{yellow5}",
          "cyan10": "{cyan1}",
          "cyan30": "{cyan2}",
          "cyan50": "{cyan3}",
          "cyan70": "{cyan4}",
          "cyan90": "{cyan5}",
          "magenta10": "{magenta1}",
          "magenta30": "{magenta2}",
          "magenta50": "{magenta3}",
          "magenta70": "{magenta4}",
          "magenta90":"{magenta5}"
        }},
        "styles": {{
          "identifier": {{
            "color": "$blue"
          }},
          "text": {{
            "color": "$fg",
            "background-color": "$bg"
          }},
          "selected-text": {{
            "background-color": "$black50"
          }},
          "alt-text": {{
            "background-color": "$black30"
          }},
          "ok": {{
            "color": "$green",
            "bold": true
          }},
          "warning": {{
            "color": "$yellow",
            "bold": true
          }},
          "error": {{
            "color": "$red",
            "bold": true
          }},
          "hidden": {{
            "color": "$grey90",
            "bold": true
          }},
          "cursor-line": {{
            "background-color": "$blue50"
          }},
          "popup": {{
            "color": "$fg",
            "background-color": "$black30"
          }},
          "focused": {{
            "color": "$fg",
            "background-color": "$black50"
          }},
          "table-border": {{
            "color": "$white50"
          }},
          "breadcrumb": {{
            "color": "$white70",
            "bold": true
          }},
          "quote-border": {{
            "color": "$white50",
            "background-color": "$black30"
          }},
          "quoted-text": {{
            "background-color": "$black30"
          }},
          "hyperlink": {{
            "color": "$cyan",
            "underline": true
          }},
          "h1": {{
            "underline": true
          }},
          "h2": {{
            "underline": true
          }}
        }},
        "syntax-styles": {{
          "keyword": {{
            "color": "$yellow"
          }},
          "string": {{
            "color": "$magenta"
          }},
          "comment": {{
            "color": "$grey90"
          }},
          "variable": {{
            "color": "$blue"
          }},
          "symbol": {{
            "color": "$magenta"
          }},
          "re-special": {{
            "color": "$cyan"
          }},
          "re-repeat": {{
            "color": "$yellow"
          }},
          "diff-delete": {{
            "color": "$red"
          }},
          "diff-add": {{
            "color": "$green"
          }},
          "diff-section": {{
            "color": "$magenta"
          }},
          "file": {{
            "color": "$blue"
          }}
        }},
        "status-styles": {{
          "title": {{
            "color": "$fg",
            "background-color": "$black50",
            "bold": true
          }},
          "subtitle": {{
            "color": "$fg",
            "background-color": "$black30",
            "bold": true
          }},
          "text": {{
            "color": "$fg",
            "background-color": "$bg"
          }},
          "warn": {{
            "color": "$yellow",
            "background-color": "$bg"
          }},
          "alert": {{
            "color": "$red",
            "background-color": "$bg"
          }},
          "active": {{
            "color": "$green",
            "background-color": "$bg"
          }},
          "info": {{
            "color": "$white70",
            "background-color": "$bg"
          }},
          "inactive": {{
            "color": "$white50",
            "background-color": "$bg"
          }}
        }},
        "log-level-styles": {{
          "trace": {{
            "color": "$fg"
          }},
          "debug": {{
            "color": "$fg"
          }},
          "info": {{
            "color": "$fg"
          }},
          "warning": {{
            "color": "$fg"
          }},
          "error": {{
            "color": "$fg"
          }},
          "critical": {{
            "color": "$fg"
          }},
          "fatal": {{
            "color": "$fg"
          }}
        }}
      }}
    }}
  }}
}}
