{{
  "$schema": "https://lnav.org/schemas/config-v1.schema.json",
  "ui": {{
    "default-colors": true,
    "theme-defs": {{
      "pywal-colors": {{
        "vars": {{
          "black1": "{black1}",
          "black2": "{black2}",
          "black3": "{black3}",
          "black4": "{black4}",
          "black5": "{black5}",
          "white1": "{white1}",
          "white2": "{white2}",
          "white3": "{white3}",
          "white4": "{white4}",
          "white5": "{white5}",
          "grey1": "{grey1}",
          "grey2": "{grey2}",
          "grey3": "{grey3}",
          "grey4": "{grey4}",
          "grey5": "{grey5}",
          "red1": "{red1}",
          "red2": "{red2}",
          "red3": "{red3}",
          "red4": "{red4}",
          "red5": "{red5}",
          "green1": "{green1}",
          "green2": "{green2}",
          "green3": "{green3}",
          "green4": "{green4}",
          "green5": "{green5}",
          "blue1": "{blue1}",
          "blue2": "{blue2}",
          "blue3": "{blue3}",
          "blue4": "{blue4}",
          "blue5": "{blue5}",
          "yellow1": "{yellow1}",
          "yellow2": "{yellow2}",
          "yellow3": "{yellow3}",
          "yellow4": "{yellow4}",
          "yellow5": "{yellow5}",
          "cyan1": "{cyan1}",
          "cyan2": "{cyan2}",
          "cyan3": "{cyan3}",
          "cyan4": "{cyan4}",
          "cyan5": "{cyan5}",
          "magenta1": "{magenta1}",
          "magenta2": "{magenta2}",
          "magenta3": "{magenta3}",
          "magenta4": "{magenta4}",
          "magenta5": "{magenta5}",
          "background": "{background}",
          "backgroundAlt": "{backgroundAlt}",
          "surface": "{surface}",
          "surfaceHover": "{surfaceHover}",
          "overlay": "{overlay}",
          "accent": "{accent}",
          "accentHover": "{accentHover}",
          "accentSubtle": "{accentSubtle}",
          "foreground": "{foreground}",
          "textSecondary": "{textSecondary}",
          "textMuted": "{textMuted}",
          "textDisabled": "{textDisabled}",
          "textInverse": "{textInverse}",
          "textLink": "{textLink}",
          "border": "{border}",
          "borderSubtle": "{borderSubtle}",
          "borderFocus": "{borderFocus}",
          "selection": "{selection}",
          "highlight": "{highlight}",
          "highlightActive": "{highlightActive}",
          "success": "{success}",
          "warning": "{warning}",
          "error": "{error}",
          "info": "{info}",
          "cursor": "{cursor}",
          "syntaxKeyword": "{syntaxKeyword}",
          "syntaxString": "{syntaxString}",
          "syntaxComment": "{syntaxComment}",
          "syntaxNumber": "{syntaxNumber}",
          "syntaxFunction": "{syntaxFunction}",
          "syntaxClass": "{syntaxClass}",
          "syntaxType": "{syntaxType}",
          "syntaxConstant": "{syntaxConstant}",
          "syntaxVariable": "{syntaxVariable}",
          "syntaxOperator": "{syntaxOperator}",
          "syntaxAnnotation": "{syntaxAnnotation}",
          "syntaxDocTag": "{syntaxDocTag}",
          "syntaxStringEscape": "{syntaxStringEscape}",
          "syntaxPunctuation": "{syntaxPunctuation}"
        }},
        "styles": {{
          "identifier": {{
            "color": "$accent"
          }},
          "text": {{
            "color": "$foreground",
            "background-color": "$background"
          }},
          "selected-text": {{
            "background-color": "$selection"
          }},
          "alt-text": {{
            "background-color": "$surface"
          }},
          "ok": {{
            "color": "$success",
            "bold": true
          }},
          "warning": {{
            "color": "$warning",
            "bold": true
          }},
          "error": {{
            "color": "$error",
            "bold": true
          }},
          "hidden": {{
            "color": "$textDisabled",
            "bold": true
          }},
          "cursor-line": {{
            "background-color": "$highlight"
          }},
          "popup": {{
            "color": "$foreground",
            "background-color": "$overlay"
          }},
          "focused": {{
            "color": "$foreground",
            "background-color": "$surface"
          }},
          "table-border": {{
            "color": "$border"
          }},
          "breadcrumb": {{
            "color": "$textSecondary",
            "bold": true
          }},
          "quote-border": {{
            "color": "$border",
            "background-color": "$surface"
          }},
          "quoted-text": {{
            "background-color": "$surface"
          }},
          "hyperlink": {{
            "color": "$textLink",
            "underline": true
          }},
          "h1": {{
            "underline": true
          }},
          "h2": {{
            "underline": true
          }}
        }},
        "syntax-styles": {{
          "keyword": {{
            "color": "$syntaxKeyword"
          }},
          "string": {{
            "color": "$syntaxString"
          }},
          "comment": {{
            "color": "$syntaxComment"
          }},
          "variable": {{
            "color": "$syntaxVariable"
          }},
          "symbol": {{
            "color": "$syntaxType"
          }},
          "re-special": {{
            "color": "$syntaxStringEscape"
          }},
          "re-repeat": {{
            "color": "$syntaxDocTag"
          }},
          "diff-delete": {{
            "color": "$error"
          }},
          "diff-add": {{
            "color": "$success"
          }},
          "diff-section": {{
            "color": "$syntaxAnnotation"
          }},
          "file": {{
            "color": "$syntaxFunction"
          }},
          "number": {{
            "color": "$syntaxNumber"
          }}
        }},
        "status-styles": {{
          "title": {{
            "color": "$foreground",
            "background-color": "$surface",
            "bold": true
          }},
          "subtitle": {{
            "color": "$foreground",
            "background-color": "$overlay",
            "bold": true
          }},
          "text": {{
            "color": "$foreground",
            "background-color": "$background"
          }},
          "warn": {{
            "color": "$warning",
            "background-color": "$background"
          }},
          "alert": {{
            "color": "$error",
            "background-color": "$background"
          }},
          "active": {{
            "color": "$success",
            "background-color": "$background"
          }},
          "info": {{
            "color": "$textSecondary",
            "background-color": "$background"
          }},
          "inactive": {{
            "color": "$textDisabled",
            "background-color": "$background"
          }}
        }},
        "log-level-styles": {{
          "trace": {{
            "color": "$foreground"
          }},
          "debug": {{
            "color": "$foreground"
          }},
          "info": {{
            "color": "$foreground"
          }},
          "warning": {{
            "color": "$foreground"
          }},
          "error": {{
            "color": "$foreground"
          }},
          "critical": {{
            "color": "$foreground"
          }},
          "fatal": {{
            "color": "$foreground"
          }}
        }}
      }}
    }}
  }}
}}
