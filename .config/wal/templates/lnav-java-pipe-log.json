{{
  "$schema": "https://lnav.org/schemas/format-v1.schema.json",
  "java_pipe_log": {{
    "title": "Java Pipe Log",
    "description": "Java logback pattern: timestamp | thread | level | logger | message",
    "url": "local",
    "regex": {{
      "std": {{
        "pattern": "^(?<timestamp>(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}})(?<sep_ts_thread> \\| )(?<thread>.{{1,30}})(?<sep_thread_level> \\| )(?<level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL)(?<sep_level_logger> \\| )(?<logger_prefix>(?:[^|.]+\\.)*)(?<logger>[^|.]+)(?<sep_logger_body> \\| )(?<body>.*)$"
      }}
    }},
    "timestamp-format": [
      "%Y-%m-%d %H:%M:%S.%L",
      "%Y-%m-%d %H:%M:%S,%L",
      "%Y-%m-%d %H:%M:%S:%L",
      "%H:%M:%S.%L",
      "%H:%M:%S,%L",
      "%H:%M:%S:%L"
    ],
    "level-field": "level",
    "body-field": "body",
    "value": {{
      "thread": {{ "kind": "string" }},
      "sep_ts_thread": {{ "kind": "string" }},
      "sep_thread_level": {{ "kind": "string" }},
      "sep_level_logger": {{ "kind": "string" }},
      "sep_logger_body": {{ "kind": "string" }},
      "logger_prefix": {{ "kind": "string" }},
      "logger": {{ "kind": "string" }}
    }},
    "level": {{
      "trace": "TRACE",
      "debug": "DEBUG",
      "info": "INFO",
      "warning": "WARN",
      "error": "ERROR",
      "fatal": "FATAL"
    }},
    "highlights": {{
      "ts_field": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}}(?= \\| )",
        "color": "{white70}"
      }},
      "thread_field": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| \\K.{{1,30}}(?= \\| (?:TRACE|DEBUG|INFO|WARN|ERROR|FATAL) \\| )",
        "color": "{white70}"
      }},
      "logger_field": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| (?:TRACE|DEBUG|INFO|WARN|ERROR|FATAL) \\| \\K[^|]+(?= \\| )",
        "color": "{white70}"
      }},
      "level_trace": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| \\KTRACE(?= \\| )",
        "color": "{yellow90}"
      }},
      "level_debug": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| \\KDEBUG(?= \\| )",
        "color": "{cyan90}"
      }},
      "level_info": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| \\KINFO(?= \\| )",
        "color": "{green90}"
      }},
      "level_warn_error_fatal": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| \\K(?:WARN|ERROR|FATAL)(?= \\| )",
        "color": "{red90}"
      }}
    }},
    "sample": [
      {{
        "line": "2026-03-17 13:53:45.014 | org.springframework.integratio | DEBUG | com.teleste.obs.extif.tcms.communication.base.utils.connection.ConnectionStateLogic | updateLifeSignalOn wasDead=false count=17 shouldEnable=false",
        "level": "debug"
      }}
    ]
  }}
}}
