{{
  "manifest_version": 3,
  "version": "1.0",
  "name": "pywal-theme",
  "theme": {{
    "colors": {{
      "frame": [{background.rgb}],
      "frame_inactive": [{black1.rgb}],
      "toolbar": [{backgroundLighter.rgb}],
      "ntp_text": [{foreground.rgb}],
      "ntp_link": [{magenta5.rgb}],
      "ntp_section": [{grey5.rgb}],
      "button_background.rgb": [{foreground.rgb}],
      "toolbar_button_icon": [{foreground.rgb}],
      "toolbar_text": [{foreground.rgb}],
      "omnibox_background.rgb": [{background.rgb}],
      "omnibox_text": [{foreground.rgb}]
    }},
    "properties": {{
      "ntp_background.rgb_alignment": "bottom"
    }}
  }}
}}
