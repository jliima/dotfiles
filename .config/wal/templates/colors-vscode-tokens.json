{{
  "textMateRules": [
    {{ "scope": "keyword", "settings": {{ "foreground": "{syntaxKeyword}" }} }},
    {{ "scope": "string", "settings": {{ "foreground": "{syntaxString}" }} }},
    {{ "scope": "comment", "settings": {{ "foreground": "{syntaxComment}" }} }},
    {{ "scope": "constant.numeric", "settings": {{ "foreground": "{syntaxNumber}" }} }},
    {{ "scope": "entity.name.function", "settings": {{ "foreground": "{syntaxFunction}" }} }},
    {{ "scope": "entity.name.class", "settings": {{ "foreground": "{syntaxClass}" }} }},
    {{ "scope": "entity.name.type", "settings": {{ "foreground": "{syntaxType}" }} }},
    {{ "scope": "constant.language", "settings": {{ "foreground": "{syntaxConstant}" }} }},
    {{ "scope": "variable", "settings": {{ "foreground": "{syntaxVariable}" }} }},
    {{ "scope": "keyword.operator", "settings": {{ "foreground": "{syntaxOperator}" }} }},
    {{ "scope": "meta.annotation, storage.type.annotation", "settings": {{ "foreground": "{syntaxAnnotation}" }} }},
    {{ "scope": "comment.block.documentation storage.type.class", "settings": {{ "foreground": "{syntaxDocTag}" }} }},
    {{ "scope": "constant.character.escape", "settings": {{ "foreground": "{syntaxStringEscape}" }} }},
    {{ "scope": "punctuation", "settings": {{ "foreground": "{syntaxPunctuation}" }} }}
  ],
  "[java]": {{
    "textMateRules": [
      {{ "scope": "keyword", "settings": {{ "foreground": "{syntaxJavaKeyword}" }} }},
      {{ "scope": "storage.modifier", "settings": {{ "foreground": "{syntaxJavaModifier}" }} }},
      {{ "scope": "variable.other.constant, storage.modifier.static.final", "settings": {{ "foreground": "{syntaxJavaStaticFinal}" }} }},
      {{ "scope": "variable.language.this, variable.language.super", "settings": {{ "foreground": "{syntaxJavaThisSuper}" }} }},
      {{ "scope": "keyword.other.import, storage.modifier.package", "settings": {{ "foreground": "{syntaxJavaImportPackage}" }} }},
      {{ "scope": "storage.type.annotation, punctuation.definition.annotation", "settings": {{ "foreground": "{syntaxJavaAnnotation}" }} }},
      {{ "scope": "string.quoted", "settings": {{ "foreground": "{syntaxJavaString}" }} }},
      {{ "scope": "constant.character.escape", "settings": {{ "foreground": "{syntaxJavaStringEscape}" }} }},
      {{ "scope": "comment.line, comment.block", "settings": {{ "foreground": "{syntaxJavaComment}" }} }},
      {{ "scope": "keyword.other.documentation", "settings": {{ "foreground": "{syntaxJavaDocTag}" }} }},
      {{ "scope": "constant.numeric", "settings": {{ "foreground": "{syntaxJavaNumber}" }} }},
      {{ "scope": "variable.other.constant", "settings": {{ "foreground": "{syntaxJavaConstant}" }} }},
      {{ "scope": "entity.name.function", "settings": {{ "foreground": "{syntaxJavaFunction}" }} }},
      {{ "scope": "entity.name.class, entity.name.type.class", "settings": {{ "foreground": "{syntaxJavaClass}" }} }},
      {{ "scope": "entity.name.type", "settings": {{ "foreground": "{syntaxJavaType}" }} }},
      {{ "scope": "variable.other", "settings": {{ "foreground": "{syntaxJavaVariable}" }} }},
      {{ "scope": "keyword.operator", "settings": {{ "foreground": "{syntaxJavaOperator}" }} }},
      {{ "scope": "punctuation", "settings": {{ "foreground": "{syntaxJavaPunctuation}" }} }}
    ]
  }},
  "[shellscript]": {{
    "textMateRules": [
      {{ "scope": "keyword", "settings": {{ "foreground": "{syntaxShellKeyword}" }} }},
      {{ "scope": "support.function, entity.name.function", "settings": {{ "foreground": "{syntaxShellExternalCommand}" }} }},
      {{ "scope": "variable, variable.other", "settings": {{ "foreground": "{syntaxShellVariable}" }} }},
      {{ "scope": "string.interpolated, punctuation.definition.string.begin", "settings": {{ "foreground": "{syntaxShellCommandSubstitution}" }} }},
      {{ "scope": "string.quoted", "settings": {{ "foreground": "{syntaxShellString}" }} }},
      {{ "scope": "comment.line", "settings": {{ "foreground": "{syntaxShellComment}" }} }},
      {{ "scope": "constant.numeric", "settings": {{ "foreground": "{syntaxShellNumber}" }} }},
      {{ "scope": "keyword.operator", "settings": {{ "foreground": "{syntaxShellOperator}" }} }},
      {{ "scope": "punctuation", "settings": {{ "foreground": "{syntaxShellPunctuation}" }} }}
    ]
  }},
  "[python]": {{
    "textMateRules": [
      {{ "scope": "keyword", "settings": {{ "foreground": "{syntaxPythonKeyword}" }} }},
      {{ "scope": "entity.name.function.decorator, punctuation.definition.decorator", "settings": {{ "foreground": "{syntaxPythonDecorator}" }} }},
      {{ "scope": "support.function.builtin, variable.language.special", "settings": {{ "foreground": "{syntaxPythonBuiltin}" }} }},
      {{ "scope": "string.quoted", "settings": {{ "foreground": "{syntaxPythonString}" }} }},
      {{ "scope": "string.quoted.byte", "settings": {{ "foreground": "{syntaxPythonByteString}" }} }},
      {{ "scope": "comment.line, comment.block", "settings": {{ "foreground": "{syntaxPythonComment}" }} }},
      {{ "scope": "constant.numeric", "settings": {{ "foreground": "{syntaxPythonNumber}" }} }},
      {{ "scope": "entity.name.function", "settings": {{ "foreground": "{syntaxPythonFunction}" }} }},
      {{ "scope": "entity.name.class, entity.name.type.class", "settings": {{ "foreground": "{syntaxPythonClass}" }} }},
      {{ "scope": "keyword.operator", "settings": {{ "foreground": "{syntaxPythonOperator}" }} }},
      {{ "scope": "punctuation", "settings": {{ "foreground": "{syntaxPythonPunctuation}" }} }}
    ]
  }},
  "[css][scss][less]": {{
    "textMateRules": [
      {{ "scope": "entity.other.attribute-name.class, entity.name.tag, entity.other.attribute-name.id", "settings": {{ "foreground": "{syntaxCssSelector}" }} }},
      {{ "scope": "support.type.property-name", "settings": {{ "foreground": "{syntaxCssPropertyName}" }} }},
      {{ "scope": "meta.property-value, support.constant.property-value", "settings": {{ "foreground": "{syntaxCssPropertyValue}" }} }},
      {{ "scope": "entity.other.attribute-name", "settings": {{ "foreground": "{syntaxCssAttributeName}" }} }},
      {{ "scope": "support.function", "settings": {{ "foreground": "{syntaxCssFunction}" }} }},
      {{ "scope": "constant.other.color", "settings": {{ "foreground": "{syntaxCssHash}" }} }},
      {{ "scope": "keyword.other.important", "settings": {{ "foreground": "{syntaxCssImportant}" }} }},
      {{ "scope": "entity.other.attribute-name.pseudo-class, entity.other.attribute-name.pseudo-element", "settings": {{ "foreground": "{syntaxCssPseudo}" }} }},
      {{ "scope": "markup.underline.link", "settings": {{ "foreground": "{syntaxCssUrl}" }} }},
      {{ "scope": "punctuation.separator.key-value.css", "settings": {{ "foreground": "{syntaxCssColon}" }} }},
      {{ "scope": "comment.block", "settings": {{ "foreground": "{syntaxCssComment}" }} }}
    ]
  }},
  "[xml][html]": {{
    "textMateRules": [
      {{ "scope": "entity.name.tag", "settings": {{ "foreground": "{syntaxXmlTagName}" }} }},
      {{ "scope": "punctuation.definition.tag", "settings": {{ "foreground": "{syntaxXmlTag}" }} }},
      {{ "scope": "entity.other.attribute-name", "settings": {{ "foreground": "{syntaxXmlAttributeName}" }} }},
      {{ "scope": "string.quoted", "settings": {{ "foreground": "{syntaxXmlAttributeValue}" }} }},
      {{ "scope": "constant.character.entity", "settings": {{ "foreground": "{syntaxXmlEntityReference}" }} }},
      {{ "scope": "comment.block", "settings": {{ "foreground": "{syntaxXmlComment}" }} }},
      {{ "scope": "entity.name.tag.custom", "settings": {{ "foreground": "{syntaxXmlCustomTagName}" }} }}
    ]
  }}
}}
