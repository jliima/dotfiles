; Qt Creator Color Tokens - dark mode

[Colors]

Token_Basic_Black={background}
Token_Basic_White={foreground}

Token_Accent_Default={green90}
Token_Accent_Muted={green90}
Token_Accent_Subtle={green90}

Token_Background_Default={background}
Token_Background_Muted={background}
Token_Background_Subtle={background}

Token_Foreground_Default={foreground}
Token_Foreground_Muted={grey90}
Token_Foreground_Subtle={grey90}

Token_Text_Default={foreground}
Token_Text_Muted={grey90}
Token_Text_Subtle={grey90}
Token_Text_Accent={green90}

Token_Stroke_Strong={foreground}
Token_Stroke_Muted={background}
Token_Stroke_Subtle={background}

Token_Notification_Alert={yellow90}
