# Pywal per-language syntax highlighting for nano, matching IntelliJ's
# colors for Java, Shell, Python, CSS and XML (see parecolors.json's
# syntax<Lang><Category> keys). Reuses the standard syntax names (java, sh,
# python, css, xml) so, included after the system nanorc's includes, it
# takes over highlighting for those file types.

syntax "java" "\.java$"
color {syntaxJavaComment} "//.*"
color {syntaxJavaComment} start="/\*" end="\*/"
color {syntaxJavaDocTag} "@[A-Za-z]+"
color {syntaxJavaString} "\"([^\"]|\\\")*\""
color {syntaxJavaNumber} "\<[0-9]+(\.[0-9]+)?[fFdDlL]?\>"
color {syntaxJavaModifier} "\<(public|private|protected|static|final|abstract|synchronized|volatile|transient)\>"
color {syntaxJavaKeyword} "\<(class|interface|enum|extends|implements|new|return|if|else|for|while|do|switch|case|break|continue|try|catch|finally|throw|throws|import|package|void|this|super|instanceof)\>"
color {syntaxJavaType} "\<(int|long|short|byte|char|boolean|float|double|String|Object)\>"

syntax "sh" "\.sh$|\.bash$|bashrc$|bash_profile$|zshrc$"
color {syntaxShellComment} "#.*"
color {syntaxShellString} "\"([^\"]|\\\")*\""
color {syntaxShellString} "'[^']*'"
color {syntaxShellVariable} "\\$[A-Za-z_][A-Za-z0-9_]*|\\$\{{[^}}]*\}}"
color {syntaxShellKeyword} "\<(if|then|else|elif|fi|for|while|until|do|done|case|esac|function|in|return|local|export)\>"
color {syntaxShellExternalCommand} "\<(echo|printf|cd|ls|grep|sed|awk|cat|rm|cp|mv|mkdir|curl|wget|git|ssh|sudo)\>"

syntax "python" "\.py$"
color {syntaxPythonComment} "#.*"
color {syntaxPythonString} "\"([^\"]|\\\")*\""
color {syntaxPythonString} "'[^']*'"
color {syntaxPythonDecorator} "^\s*@[A-Za-z_.]+"
color {syntaxPythonNumber} "\<[0-9]+(\.[0-9]+)?\>"
color {syntaxPythonKeyword} "\<(def|class|import|from|as|return|if|elif|else|for|while|try|except|finally|raise|with|lambda|yield|pass|break|continue|and|or|not|in|is|None|True|False)\>"
color {syntaxPythonBuiltin} "\<(self|cls|print|len|range|str|int|float|list|dict|set|tuple|isinstance|super)\>"

syntax "css" "\.css$|\.scss$|\.less$"
color {syntaxCssComment} start="/\*" end="\*/"
color {syntaxCssUrl} "url\([^)]*\)"
color {syntaxCssSelector} "^[ \t]*[.#]?[A-Za-z0-9_-]+(::?[A-Za-z-]+)?[ \t]*\{{"
color {syntaxCssPropertyName} "\<[a-z-]+\>[ \t]*:"
color {syntaxCssHash} "#[0-9A-Fa-f]{{3,8}}\>"
color {syntaxCssImportant} "!important"

syntax "xml" "\.xml$|\.xsd$|\.xsl$|\.svg$"
color {syntaxXmlComment} start="<!--" end="-->"
color {syntaxXmlTag} "</?"
color {syntaxXmlTagName} "</?[A-Za-z_:][A-Za-z0-9_:.-]*"
color {syntaxXmlAttributeName} "[A-Za-z_:][A-Za-z0-9_:.-]*(?==)"
color {syntaxXmlAttributeValue} "\"[^\"]*\""
color {syntaxXmlEntityReference} "&[A-Za-z0-9#]+;"
