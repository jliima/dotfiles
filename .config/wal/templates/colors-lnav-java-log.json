{{
  "$schema": "https://lnav.org/schemas/format-v1.schema.json",
  "java_log": {{
    "highlights": {{
      "ts_field": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}}(?= \\| )",
        "color": "{grey5}"
      }},
      "thread_field": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| \\K.{{1,30}}(?= \\| (?:TRACE|DEBUG|INFO|WARN|ERROR|FATAL) \\| )",
        "color": "{grey5}"
      }},
      "logger_field": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| (?:TRACE|DEBUG|INFO|WARN|ERROR|FATAL) \\| \\K[^|]+(?= \\| )",
        "color": "{grey5}"
      }},
      "level_trace": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| \\KTRACE(?= \\| )",
        "color": "{yellow5}"
      }},
      "level_debug": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| \\KDEBUG(?= \\| )",
        "color": "{cyan5}"
      }},
      "level_info": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| \\KINFO(?= \\| )",
        "color": "{green5}"
      }},
      "level_warn_error_fatal": {{
        "pattern": "^(?:\\d{{4}}-\\d{{2}}-\\d{{2}} )?\\d{{2}}:\\d{{2}}:\\d{{2}}[.:,]\\d{{3}} \\| .{{1,30}} \\| \\K(?:WARN|ERROR|FATAL)(?= \\| )",
        "color": "{red5}"
      }}
    }}
  }}
}}
