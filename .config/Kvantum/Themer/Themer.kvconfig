interior=true
interior.element=group
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
text.shadow=false
text.margin=0
text.bold=true

[ToolTip]
inherits=GenericFrame
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
text.shadow=false
text.margin=2
interior.element=tooltip
frame.element=tooltip
text.normal.color=#1a2530

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
