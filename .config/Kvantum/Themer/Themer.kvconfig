text.focus.color=#1a2530
text.press.color=#1a2530
text.toggle.color=#1a2530
text.margin.top=6
text.margin.bottom=5
text.margin.left=12
text.margin.right=12

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
min_height=0

[TabBarFrame]
inherits=GenericFrame
frame=true
frame.element=tabbarframe
interior=false
frame.top=0
frame.bottom=1
frame.left=0
frame.right=0

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
