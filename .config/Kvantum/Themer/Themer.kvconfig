text.bold=false
indicator.element=arrow
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

[SizeGrip]
indicator.element=sizegrip

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
frame=false
interior=false
frame.element=toolbar
interior.element=toolbar
min_height=0
text.normal.color=#3c4956

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false
frame.element=menubar
interior.element=menubar
min_height=0

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
min_height=0
text.normal.color=#1a2530
text.margin.top=0
text.margin.bottom=0
text.margin.left=4
text.margin.right=4

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
min_height=0
text.normal.color=#1a2530

[MenuItem]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
# The frame holds the inset (menu-padding) and the rounded highlight (radius-sm).
frame.top=6
frame.bottom=6
frame.left=10
frame.right=10
min_height=28
text.normal.color=#1a2530
text.focus.color=#1a2530
text.press.color=#1a2530
text.toggle.color=#1a2530
text.margin.top=0
text.margin.bottom=0
text.margin.left=8
text.margin.right=8

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=6
min_height=0
text.normal.color=#1a2530
text.focus.color=#1a2530
text.press.color=#1a2530
text.toggle.color=#1a2530
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=splitter
frame.element=splitter
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=0

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false
interior.element=scrollgroove
frame.element=scrollgroove

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5
interior=false
indicator.element=grip
indicator.size=0
min_height=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=false
min_height=0

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor
min_height=0

[Progressbar]
inherits=PanelButtonCommand
