# Written by Themer: the Kvantum theme "Themer" for Pare light. The SVG next to it
# comes from themer/kvantum.py; both follow the applied theme's tokens.
[%General]
author=Themer
comment=Pare light, generated by Themer
respect_DE=true
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
center_normal_tabs=false
center_doc_tabs=false
joined_inactive_tabs=true
attach_active_tab=false
embedded_tabs=false
no_active_tab_separator=false
group_toolbar_buttons=false
toolbutton_style=0
composite=true
translucent_windows=false
blurring=false
popup_blurring=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
menu_separator_height=9
submenu_overlap=0
scroll_width=10
scroll_arrows=false
scroll_min_extent=36
scrollbar_in_view=true
transient_scrollbar=false
slider_width=4
slider_handle_width=16
slider_handle_length=16
tickless_slider_handle_size=16
progressbar_thickness=6
spread_progressbar=true
check_size=16
splitter_width=5
inline_spin_indicators=true
vertical_spin_indicators=true
spin_button_width=18
combo_as_lineedit=true
combo_menu=true
square_combo_button=false
animate_states=true
tree_branch_line=false
fill_rubberband=false
no_inactiveness=true
no_selection_tint=true
dark_titlebar=0
layout_spacing=6
layout_margin=8
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
toolbar_item_spacing=2
toolbar_interior_spacing=2
toolbar_separator_thickness=1
tooltip_delay=600
submenu_delay=200
menubar_mouse_tracking=true
merge_menubar_with_toolbar=false
transparent_dolphin_view=false
transparent_ktitle_label=true
transparent_menutitle=true
remove_extra_frames=true
dialog_button_layout=0
click_behavior=0
kinetic_scrolling=false
middle_click_scroll=false
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,kamoso,QtCreator,VirtualBox,VirtualBoxVM,trojita,dragon,digikam,lyx

[GeneralColors]
window.color=#e9edf2
base.color=#f4f7fa
alt.base.color=#f7f9fc
button.color=#e4eaf0
light.color=#d9e1e8
mid.light.color=#ffffff
dark.color=#dee4e9
mid.color=#d7dde3
shadow.color=#dee4e9
highlight.color=#dbeeff
inactive.highlight.color=#dbeeff
tooltip.base.color=#ffffff
text.color=#1a2530
window.text.color=#1a2530
button.text.color=#1a2530
disabled.text.color=#979fa8
tooltip.text.color=#1a2530
highlight.text.color=#1a2530
link.color=#156eac
link.visited.color=#7858b3
progress.indicator.text.color=#1a2530

[Hacks]
respect_darkness=true
transparent_dolphin_view=false
force_size_grip=false
tint_on_mouseover=0
no_selection_tint=true
disabled_icon_opacity=60
normal_default_pushbutton=true
iconless_pushbutton=false
iconless_menu=false
single_top_toolbar=false
style_vertical_toolbars=false
middle_click_scroll=false
centered_forms=false
kcapacitybar_as_progressbar=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=button
indicator.element=arrow
indicator.size=10
min_height=32
text.normal.color=#1a2530
text.focus.color=#1a2530
text.press.color=#1a2530
text.toggle.color=#1a2530
text.shadow=false
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.iconspacing=6

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
min_height=0
text.normal.color=#3c4956
text.margin.left=4
text.margin.right=4

[ToolboxTab]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=dock
text.normal.color=#515f6d
text.focus.color=#1a2530
text.bold=false
min_height=0

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=10

[RadioButton]
inherits=PanelButtonCommand
interior.element=radio
min_height=0
text.margin.left=4
text.margin.right=4

[CheckBox]
inherits=PanelButtonCommand
interior.element=checkbox
min_height=0
text.margin.left=4
text.margin.right=4

[Focus]
inherits=PanelButtonCommand
interior=false
frame=true
frame.element=focus
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
min_height=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.normal.color=#1a2530

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow-down

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=10

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior=false
interior.element=tab
indicator.element=tab
frame.top=0
frame.bottom=3
frame.left=0
frame.right=0
min_height=0
